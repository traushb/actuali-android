    "Your server's security certificate has expired, so Android blocked the connection. Renewing the certificate on the server will fix this. See %@ for help.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Serverzertifikat ist abgelaufen, daher hat Android die Verbindung blockiert. Erneuere es. Hilfe findest du unter %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server's security certificate has expired, so Android blocked the connection. Renewing the certificate on the server will fix this. See %@ for help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado del servidor ha caducado y Android bloqueó la conexión. Renueva el certificado. Consulta %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de votre serveur a expiré et Android a bloqué la connexion. Renouvelez-le. Consultez %@ pour obtenir de l’aide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il certificato del server è scaduto e Android ha bloccato la connessione. Rinnovalo. Consulta %@ per assistenza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het servercertificaat is verlopen, dus Android blokkeerde de verbinding. Vernieuw het. Zie %@ voor hulp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado do servidor expirou e o Android bloqueou a conexão. Renove-o. Consulte %@ para obter ajuda."
          }
        }
      }
    }
  },
